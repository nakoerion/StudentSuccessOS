# Copy to .env at the repo root:  cp .env.example .env
# Local development values only. Never commit a real .env.

# Runtime connection used by the app and by tests.
# ssos_app is NOSUPERUSER + NOBYPASSRLS, so every query is subject to row-level security.
DATABASE_URL="postgresql://ssos_app:ssos_app_dev@localhost:5432/ssos?schema=public"

# Owner/admin connection: owns the schema, runs migrations and the seed.
# ssos_owner is NOSUPERUSER but has BYPASSRLS (needed because tables use FORCE ROW LEVEL SECURITY).
# Prisma Migrate uses this automatically via `directUrl` in schema.prisma.
DATABASE_ADMIN_URL="postgresql://ssos_owner:ssos_owner_dev@localhost:5432/ssos?schema=public"
