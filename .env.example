# Copy to .env at the repo root. Never commit a real .env (it is gitignored).
#
# Two ways to fill this file:
#   A) Supabase Postgres (the team's shared DB):
#        source /etc/profile.d/cto-env-vars.sh   # SUPABASE_DB_URL + SUPABASE_* keys
#        bash scripts/supabase-db-up.sh          # creates roles, writes DATABASE_* + SUPABASE_* below
#   B) Local Postgres 16 (offline dev):  bash scripts/db-up.sh  (copies this file as-is)
#
# ── Database ────────────────────────────────────────────────────────────────
# Two roles, two URLs. NEVER point DATABASE_URL at Supabase's `postgres` role:
# it has BYPASSRLS, which would silently switch off tenant isolation.
#
# DATABASE_URL — runtime (Next.js app, `@ssos/db` prisma client, tests). SERVER-ONLY.
# Role ssos_app: NOSUPERUSER + NOBYPASSRLS, so every query is subject to RLS.
#   Supabase: transaction pooler (Supavisor, IPv4), user is "<role>.<project-ref>",
#   `pgbouncer=true` turns off Prisma's prepared statements (required in transaction mode).
#   withTenant() only uses transaction-local settings (set_config(..., true)), so pooling
#   per transaction cannot leak a tenant between requests.
#   DATABASE_URL="postgresql://ssos_app.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
DATABASE_URL="postgresql://ssos_app:ssos_app_dev@localhost:5432/ssos?schema=public"
#
# DATABASE_ADMIN_URL — migrations + seed only (Prisma `directUrl`, `pnpm db:seed`,
# `pnpm auth:seed`, test assertions). SERVER-ONLY, never used by request handlers.
# Role ssos_owner: NOSUPERUSER, BYPASSRLS (tables use FORCE ROW LEVEL SECURITY); it creates
# the SSOS tables, so Supabase's default grants to anon/authenticated do not apply to them.
#   Supabase: a session-mode connection (Migrate needs one). Use the direct host
#   db.<ref>.supabase.co:5432 if your machine has IPv6 (or the IPv4 add-on); otherwise the
#   session pooler, port 5432 — supabase-db-up.sh picks automatically.
#   DATABASE_ADMIN_URL="postgresql://ssos_owner.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_ADMIN_URL="postgresql://ssos_owner:ssos_owner_dev@localhost:5432/ssos?schema=public"
#
# SUPABASE_DB_URL (environment only, not in this file) is the direct `postgres` URL. It is
# used solely by scripts/supabase-db-up.sh to create the two roles above.

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Supabase stores passwords and issues the session (cookie-based, @supabase/ssr).
# Values: Supabase dashboard -> Project Settings -> API keys. Never commit real values.
#
# Project URL. Not secret.
SUPABASE_URL="https://your-project-ref.supabase.co"
# PUBLIC (client-safe) publishable key, sb_publishable_*. Used by the server
# client and middleware today; safe to expose to a browser (as NEXT_PUBLIC_*)
# if a browser client is ever added. Row access is still enforced by RLS.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# SERVER-ONLY secret key, sb_secret_* (service role: bypasses Supabase auth rules).
# Used only by `pnpm auth:seed` (admin API). NEVER expose it to the browser,
# never prefix it with NEXT_PUBLIC_, never import it from client code.
SUPABASE_SECRET_KEY="sb_secret_xxx"
