# Copy to .env at the repo root:  cp .env.example .env
# Local development values only. Never commit a real .env.

# Runtime connection used by the app and by tests.
# ssos_app is NOSUPERUSER + NOBYPASSRLS, so every query is subject to row-level security.
DATABASE_URL="postgresql://ssos_app:ssos_app_dev@localhost:5432/ssos?schema=public"

# Owner/admin connection: owns the schema, runs migrations and the seed.
# ssos_owner is NOSUPERUSER but has BYPASSRLS (needed because tables use FORCE ROW LEVEL SECURITY).
# Prisma Migrate uses this automatically via `directUrl` in schema.prisma.
DATABASE_ADMIN_URL="postgresql://ssos_owner:ssos_owner_dev@localhost:5432/ssos?schema=public"

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Supabase stores passwords and issues the session (cookie-based, @supabase/ssr).
# Only AUTH is on Supabase; the database above stays local Postgres.
# Values: Supabase dashboard -> Project Settings -> API keys. Never commit real values.
#
# Project URL. Not secret.
SUPABASE_URL="https://your-project-ref.supabase.co"
# PUBLIC (client-safe) publishable key, sb_publishable_*. Used by the server
# client and middleware today; safe to expose to a browser (as NEXT_PUBLIC_*)
# if a browser client is ever added. Row access is still enforced by RLS.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# SERVER-ONLY secret key, sb_secret_* (service role: bypasses Supabase auth rules).
# Used only by `pnpm auth:seed` (admin API). NEVER expose it to the browser,
# never prefix it with NEXT_PUBLIC_, never import it from client code.
SUPABASE_SECRET_KEY="sb_secret_xxx"
