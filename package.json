{
  "name": "sso",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint --concurrency=1",
    "test": "turbo run test --concurrency=1",
    "db:up": "bash scripts/db-up.sh",
    "db:up:supabase": "bash scripts/supabase-db-up.sh",
    "db:generate": "pnpm --filter @ssos/db db:generate",
    "db:migrate": "pnpm --filter @ssos/db db:migrate",
    "db:seed": "pnpm --filter @ssos/db db:seed",
    "db:reset": "pnpm --filter @ssos/db db:reset",
    "auth:seed": "pnpm --filter @ssos/db auth:seed",
    "rls:generate": "pnpm --filter @ssos/db rls:generate"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
