// Student Success OS — core schema (Slice 1).
//
// Conventions
// - UUID primary keys generated in Postgres (gen_random_uuid()).
// - created_at / updated_at on every table.
// - Every tenant-owned table has `tenant_id uuid` with an FK to tenant and an
//   index, and is protected by row-level security generated from ONE template
//   in rls/generate.ts (see rls/tables.ts for the list).
// - "Shared" tables (role, role_permission, grade_scale) have a NULLABLE
//   tenant_id: NULL means a global/system row visible to every tenant,
//   non-NULL means a tenant-defined row visible only to that tenant.
// - Global tables (no tenant_id): tenant, country_pack, permission,
//   user_account (auth identity; a person in a tenant links to it).
// - References between tenant-owned rows use composite FKs
//   (tenant_id, x_id) -> x(tenant_id, id) so a row can never point at another
//   tenant's data, even though FK checks bypass RLS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: ssos_app (NOSUPERUSER, NOBYPASSRLS).
  url       = env("DATABASE_URL")
  // Migrations: ssos_owner (schema owner, BYPASSRLS).
  directUrl = env("DATABASE_ADMIN_URL")
}

// ─── Global tables ───────────────────────────────────────────────────────────

model CountryPack {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(2)
  name      String
  version   String
  /// Full pack payload from @ssos/country-packs.
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenants     Tenant[]
  gradeScales GradeScale[]
  concepts    Concept[]

  @@map("country_pack")
}

model Tenant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique
  name          String
  countryPackId String   @map("country_pack_id") @db.Uuid
  defaultLocale String   @map("default_locale") @db.VarChar(8)
  timezone      String
  /// Short code a user types on "Join your school".
  joinCode      String   @unique @map("join_code")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  countryPack     CountryPack      @relation(fields: [countryPackId], references: [id], onDelete: Restrict)
  units           TenantUnit[]
  settings        TenantSetting[]
  gradeScales     GradeScale[]
  persons         Person[]
  roles           Role[]
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]
  guardianships   Guardianship[]
  consents        Consent[]
  invitations     Invitation[]
  rosterImports   RosterImport[]
  auditLogs       AuditLog[]

  // Academic record
  academicYears        AcademicYear[]
  terms                Term[]
  subjects             Subject[]
  courses              Course[]
  classSections        ClassSection[]
  enrollments          Enrollment[]
  teacherAssignments   TeacherAssignment[]
  timetableSlots       TimetableSlot[]
  attendanceEvents     AttendanceEvent[]
  assessmentCategories AssessmentCategory[]
  gradeEntries         GradeEntry[]
  termGrades           TermGrade[]
  annualGrades         AnnualGrade[]
  assignments          Assignment[]
  submissions          Submission[]
  rubricScores         RubricScore[]
  notes                Note[]
  events               Event[]
  edges                Edge[]
  masteryStates        MasteryState[]

  // Success engine
  riskModelConfigs  RiskModelConfig[]
  riskScores        RiskScore[]
  trackAssignments  TrackAssignment[]
  actionCards       ActionCard[]
  alertRules        AlertRule[]
  alerts            Alert[]
  interventions     Intervention[]
  interventionTasks InterventionTask[]
  goals             Goal[]
  goalProgress      GoalProgress[]
  nudges            Nudge[]

  // Communications
  threads                 Thread[]
  messages                Message[]
  channelBindings         ChannelBinding[]
  outbox                  Outbox[]
  announcements           Announcement[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  digestRuns              DigestRun[]

  @@index([countryPackId])
  @@map("tenant")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "roster.read", "roster.write".
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permission")
}

model UserAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique
  /// Supabase Auth subject (auth.users.id). The session identity maps here.
  externalAuthId String?   @unique @map("external_auth_id")
  displayName    String?   @map("display_name")
  locale         String?   @db.VarChar(8)
  lastSignInAt   DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  persons Person[]

  @@map("user_account")
}

// ─── Shared tables (tenant_id NULL = system/global row) ─────────────────────

model GradeScale {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL = the country pack's default scale; otherwise a tenant override.
  tenantId      String?  @map("tenant_id") @db.Uuid
  countryPackId String   @map("country_pack_id") @db.Uuid
  key           String
  name          String
  kind          String
  minValue      Decimal  @map("min_value") @db.Decimal(6, 2)
  maxValue      Decimal  @map("max_value") @db.Decimal(6, 2)
  passMark      Decimal  @map("pass_mark") @db.Decimal(6, 2)
  bands         Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  countryPack CountryPack @relation(fields: [countryPackId], references: [id], onDelete: Restrict)

  courses      Course[]
  gradeEntries GradeEntry[]
  termGrades   TermGrade[]
  annualGrades AnnualGrade[]

  @@unique([countryPackId, tenantId, key])
  @@index([tenantId])
  @@map("grade_scale")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL = system role (Student, Parent, Teacher, Advisor, Trainer, Admin).
  tenantId    String?  @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  assignments     RoleAssignment[]
  invitations     Invitation[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL for system role grants; tenant id for grants on tenant-defined roles.
  tenantId     String?  @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
  @@map("role_permission")
}

// ─── Tenant-owned tables (tenant_id NOT NULL) ────────────────────────────────

model TenantUnit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  /// "campus" | "grade" | "class" | ... (free-form for now).
  kind       String
  name       String
  code       String
  gradeLevel Int?     @map("grade_level")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          TenantUnit?      @relation("UnitTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction)
  children        TenantUnit[]     @relation("UnitTree")
  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  classSections   ClassSection[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("tenant_unit")
}

model TenantSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_setting")
}

model Person {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// Optional link to a login identity. Students may have no account.
  userAccountId String?   @map("user_account_id") @db.Uuid
  givenName     String    @map("given_name")
  familyName    String    @map("family_name")
  displayName   String    @map("display_name")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  locale        String?   @db.VarChar(8)
  /// School-issued identifier (student number, staff number).
  externalRef   String?   @map("external_ref")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccount     UserAccount?     @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  roleAssignments RoleAssignment[]
  guardianOf      Guardianship[]   @relation("GuardianPerson")
  guardedBy       Guardianship[]   @relation("StudentPerson")
  consentsAbout   Consent[]        @relation("ConsentSubject")
  consentsGiven   Consent[]        @relation("ConsentGrantor")
  invitationsSent Invitation[]     @relation("InvitationInviter")
  invitationsFor  Invitation[]     @relation("InvitationPerson")
  rosterImports   RosterImport[]
  auditLogs       AuditLog[]

  // Academic record
  enrollments        Enrollment[]        @relation("EnrollmentStudent")
  teacherAssignments TeacherAssignment[] @relation("TeacherAssignmentTeacher")
  attendanceAbout    AttendanceEvent[]   @relation("AttendanceStudent")
  attendanceRecorded AttendanceEvent[]   @relation("AttendanceRecorder")
  gradeEntriesGiven  GradeEntry[]        @relation("GradeEntryGrader")
  assignmentsCreated Assignment[]        @relation("AssignmentCreator")
  submissions        Submission[]        @relation("SubmissionStudent")
  rubricScoresGiven  RubricScore[]       @relation("RubricScoreScorer")
  notesAbout         Note[]              @relation("NoteSubject")
  notesWritten       Note[]              @relation("NoteAuthor")
  eventsActed        Event[]             @relation("EventActor")
  eventsAbout        Event[]             @relation("EventSubject")
  masteryStates      MasteryState[]      @relation("MasteryStudent")

  // Success engine
  riskModelConfigsCreated RiskModelConfig[]  @relation("RiskModelConfigCreator")
  riskScores              RiskScore[]        @relation("RiskScoreStudent")
  trackAssignments        TrackAssignment[]  @relation("TrackAssignmentStudent")
  actionCardsAbout        ActionCard[]       @relation("ActionCardSubject")
  actionCardsDecided      ActionCard[]       @relation("ActionCardDecider")
  alerts                  Alert[]            @relation("AlertStudent")
  interventions           Intervention[]     @relation("InterventionStudent")
  interventionsOwned      Intervention[]     @relation("InterventionOwner")
  interventionTasks       InterventionTask[] @relation("InterventionTaskAssignee")
  goals                   Goal[]             @relation("GoalStudent")
  goalsCreated            Goal[]             @relation("GoalCreator")
  nudgesReceived          Nudge[]            @relation("NudgeRecipient")

  // Communications
  threadsAbout            Thread[]                 @relation("ThreadStudent")
  threadsCreated          Thread[]                 @relation("ThreadCreator")
  messagesAuthored        Message[]                @relation("MessageAuthor")
  channelBindings         ChannelBinding[]         @relation("ChannelBindingPerson")
  outboxReceived          Outbox[]                 @relation("OutboxRecipient")
  announcementsAuthored   Announcement[]           @relation("AnnouncementAuthor")
  notificationsReceived   Notification[]           @relation("NotificationRecipient")
  notificationsAbout      Notification[]           @relation("NotificationSubject")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferencePerson")

  @@unique([tenantId, id])
  @@unique([tenantId, userAccountId])
  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@index([userAccountId])
  @@map("person")
}

model RoleAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  /// Optional scope, e.g. the class a teacher teaches or a student is in.
  tenantUnitId String?   @map("tenant_unit_id") @db.Uuid
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(6)
  /// "active" | "pending" (claimed with a join code, awaiting approval).
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person     Person      @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenantUnit TenantUnit? @relation(fields: [tenantId, tenantUnitId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, personId])
  @@index([roleId])
  @@index([tenantId, tenantUnitId])
  @@map("role_assignment")
}

model Guardianship {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  guardianPersonId String   @map("guardian_person_id") @db.Uuid
  studentPersonId  String   @map("student_person_id") @db.Uuid
  /// "mother" | "father" | "guardian" | ...
  relationship     String
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardian Person @relation("GuardianPerson", fields: [tenantId, guardianPersonId], references: [tenantId, id], onDelete: Cascade)
  student  Person @relation("StudentPerson", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, guardianPersonId, studentPersonId])
  @@index([tenantId])
  @@index([tenantId, studentPersonId])
  @@map("guardianship")
}

model Consent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  subjectPersonId   String    @map("subject_person_id") @db.Uuid
  /// Who gave consent: the subject (if old enough per country pack) or a guardian.
  grantedByPersonId String?   @map("granted_by_person_id") @db.Uuid
  /// e.g. "data_processing", "photo".
  purpose           String
  grantedAt         DateTime? @map("granted_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject   Person  @relation("ConsentSubject", fields: [tenantId, subjectPersonId], references: [tenantId, id], onDelete: Cascade)
  grantedBy Person? @relation("ConsentGrantor", fields: [tenantId, grantedByPersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, subjectPersonId])
  @@map("consent")
}

model Invitation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// Opaque token used in invite links.
  token             String    @unique
  /// Short human code (optional) for typing in.
  code              String?   @unique
  email             String?
  roleId            String    @map("role_id") @db.Uuid
  tenantUnitId      String?   @map("tenant_unit_id") @db.Uuid
  personId          String?   @map("person_id") @db.Uuid
  invitedByPersonId String?   @map("invited_by_person_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenantUnit TenantUnit? @relation(fields: [tenantId, tenantUnitId], references: [tenantId, id], onDelete: NoAction)
  person     Person?     @relation("InvitationPerson", fields: [tenantId, personId], references: [tenantId, id], onDelete: NoAction)
  invitedBy  Person?     @relation("InvitationInviter", fields: [tenantId, invitedByPersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([roleId])
  @@map("invitation")
}

model RosterImport {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// "csv" | "oneroster"
  source            String
  status            String    @default("pending")
  fileName          String?   @map("file_name")
  /// Validation report (Slice: rostering).
  report            Json?
  startedByPersonId String?   @map("started_by_person_id") @db.Uuid
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedBy Person? @relation(fields: [tenantId, startedByPersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@map("roster_import")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorPersonId String?  @map("actor_person_id") @db.Uuid
  /// Auth identity of the actor (from app.user_id).
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  Person? @relation(fields: [tenantId, actorPersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_log")
}

// ─── Academic record (slice: academic record, part 1 — schema only) ─────────
//
// Global curriculum tables (no tenant_id): concept, concept_edge — read-only to
// the app role (forced RLS + global_read). Everything else is tenant-owned and
// goes through the one tenant template in rls/generate.ts, with an access mode:
//   - read_write  (default): SELECT/INSERT/UPDATE/DELETE under tenant_isolation
//   - append_only (event):   SELECT/INSERT only — UPDATE/DELETE denied
//   - derived     (term_grade, annual_grade): SELECT only — rows are written by
//     the grade-derivation service (owner role / SECURITY DEFINER), never by hand
// Tenant-owned references use composite FKs (tenant_id, x_id) as above.

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@map("attendance_status")
}

enum AttendanceMethod {
  grid
  qr

  @@map("attendance_method")
}

enum AiPolicy {
  allowed
  guided
  forbidden

  @@map("ai_policy")
}

enum SubmissionStatus {
  draft
  submitted
  returned
  resubmitted
  graded

  @@map("submission_status")
}

enum NoteVisibility {
  internal
  parent
  student

  @@map("note_visibility")
}

// ── Global curriculum ──

model Concept {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId String   @map("country_pack_id") @db.Uuid
  /// Curriculum code as published by the pack's authority (unique per pack).
  code          String
  name          String
  /// Subject key the concept belongs to (matches subject.code where seeded from the pack).
  subjectKey    String?  @map("subject_key")
  /// Pack grade label, e.g. "10".
  grade         String?
  description   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  countryPack   CountryPack    @relation(fields: [countryPackId], references: [id], onDelete: Cascade)
  edgesOut      ConceptEdge[]  @relation("ConceptEdgeSource")
  edgesIn       ConceptEdge[]  @relation("ConceptEdgeTarget")
  masteryStates MasteryState[]

  @@unique([countryPackId, code])
  @@index([countryPackId, subjectKey])
  @@map("concept")
}

model ConceptEdge {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceConceptId String   @map("source_concept_id") @db.Uuid
  targetConceptId String   @map("target_concept_id") @db.Uuid
  /// "prerequisite" | "part_of" | "related"
  edgeType        String   @map("edge_type")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source Concept @relation("ConceptEdgeSource", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  target Concept @relation("ConceptEdgeTarget", fields: [targetConceptId], references: [id], onDelete: Cascade)

  @@unique([sourceConceptId, targetConceptId, edgeType])
  @@index([targetConceptId])
  @@map("concept_edge")
}

// ── School year structure ──

model AcademicYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// e.g. "2026-2027" (matches the pack's examCalendars[].academicYear).
  name      String
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms        Term[]
  courses      Course[]
  annualGrades AnnualGrade[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("academic_year")
}

model Term {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  /// Pack term key (e.g. "term-1") or a tenant-defined key.
  key            String
  name           String
  sequence       Int
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime  @map("ends_on") @db.Date
  /// Term lock (gradebook moderation, later slice). NULL = open.
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear    @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Cascade)
  timetableSlots TimetableSlot[]
  gradeEntries   GradeEntry[]
  termGrades     TermGrade[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, key])
  @@unique([tenantId, academicYearId, sequence])
  @@index([tenantId])
  @@map("term")
}

model Subject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  /// Origin hint: country-pack code this subject was seeded from; NULL = tenant-defined.
  packCode  String?  @map("pack_code") @db.VarChar(2)
  /// Subject key inside the pack (when packCode is set).
  packKey   String?  @map("pack_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subject")
}

model Course {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  code           String
  name           String
  /// Pack grade label, e.g. "10".
  grade          String?
  credits        Decimal? @db.Decimal(5, 2)
  /// Scale used for this course's grades (pack default or tenant override).
  gradeScaleId   String?  @map("grade_scale_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear         AcademicYear         @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Cascade)
  subject              Subject              @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: NoAction)
  gradeScale           GradeScale?          @relation(fields: [gradeScaleId], references: [id], onDelete: NoAction)
  classSections        ClassSection[]
  teacherAssignments   TeacherAssignment[]
  assessmentCategories AssessmentCategory[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, code])
  @@index([tenantId])
  @@index([tenantId, subjectId])
  @@map("course")
}

model ClassSection {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  /// Optional homeroom / class unit the section is drawn from.
  tenantUnitId String?  @map("tenant_unit_id") @db.Uuid
  code         String
  name         String
  capacity     Int?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  tenantUnit         TenantUnit?         @relation(fields: [tenantId, tenantUnitId], references: [tenantId, id], onDelete: NoAction)
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  assignments        Assignment[]
  threads            Thread[]
  announcements      Announcement[]

  @@unique([tenantId, id])
  @@unique([tenantId, courseId, code])
  @@index([tenantId])
  @@map("class_section")
}

model Enrollment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  classSectionId  String    @map("class_section_id") @db.Uuid
  studentPersonId String    @map("student_person_id") @db.Uuid
  /// "active" | "withdrawn" | "completed"
  status          String    @default("active")
  startsOn        DateTime? @map("starts_on") @db.Date
  endsOn          DateTime? @map("ends_on") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSection     ClassSection      @relation(fields: [tenantId, classSectionId], references: [tenantId, id], onDelete: Cascade)
  student          Person            @relation("EnrollmentStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  attendanceEvents AttendanceEvent[]
  gradeEntries     GradeEntry[]
  termGrades       TermGrade[]
  annualGrades     AnnualGrade[]

  @@unique([tenantId, id])
  @@unique([tenantId, classSectionId, studentPersonId])
  @@index([tenantId])
  @@index([tenantId, studentPersonId])
  @@map("enrollment")
}

model TeacherAssignment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  teacherPersonId String   @map("teacher_person_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  /// NULL = teaches every section of the course.
  classSectionId  String?  @map("class_section_id") @db.Uuid
  /// "primary" | "co_teacher" | "assistant"
  role            String   @default("primary")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher        Person          @relation("TeacherAssignmentTeacher", fields: [tenantId, teacherPersonId], references: [tenantId, id], onDelete: Cascade)
  course         Course          @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  classSection   ClassSection?   @relation(fields: [tenantId, classSectionId], references: [tenantId, id], onDelete: NoAction)
  timetableSlots TimetableSlot[]

  @@unique([tenantId, id])
  @@unique([tenantId, teacherPersonId, courseId, classSectionId])
  @@index([tenantId])
  @@index([tenantId, courseId])
  @@map("teacher_assignment")
}

model TimetableSlot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  classSectionId      String   @map("class_section_id") @db.Uuid
  teacherAssignmentId String?  @map("teacher_assignment_id") @db.Uuid
  /// NULL = applies to every term of the year.
  termId              String?  @map("term_id") @db.Uuid
  room                String?
  /// ISO weekday, 1 = Monday … 7 = Sunday.
  dayOfWeek           Int      @map("day_of_week") @db.SmallInt
  startsAt            DateTime @map("starts_at") @db.Time(0)
  endsAt              DateTime @map("ends_at") @db.Time(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSection      ClassSection       @relation(fields: [tenantId, classSectionId], references: [tenantId, id], onDelete: Cascade)
  teacherAssignment TeacherAssignment? @relation(fields: [tenantId, teacherAssignmentId], references: [tenantId, id], onDelete: NoAction)
  term              Term?              @relation(fields: [tenantId, termId], references: [tenantId, id], onDelete: NoAction)
  attendanceEvents  AttendanceEvent[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, classSectionId])
  @@index([tenantId, dayOfWeek])
  @@map("timetable_slot")
}

model AttendanceEvent {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  enrollmentId       String           @map("enrollment_id") @db.Uuid
  studentPersonId    String           @map("student_person_id") @db.Uuid
  timetableSlotId    String?          @map("timetable_slot_id") @db.Uuid
  date               DateTime         @db.Date
  status             AttendanceStatus
  method             AttendanceMethod @default(grid)
  recordedByPersonId String?          @map("recorded_by_person_id") @db.Uuid
  comment            String?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment    Enrollment     @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  student       Person         @relation("AttendanceStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  timetableSlot TimetableSlot? @relation(fields: [tenantId, timetableSlotId], references: [tenantId, id], onDelete: NoAction)
  recordedBy    Person?        @relation("AttendanceRecorder", fields: [tenantId, recordedByPersonId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, enrollmentId, date, timetableSlotId])
  @@index([tenantId])
  @@index([tenantId, studentPersonId, date])
  @@map("attendance_event")
}

// ── Gradebook ──

model AssessmentCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  name      String
  /// Percentage weight within the course (0–100).
  weight    Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  gradeEntries GradeEntry[]
  assignments  Assignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, courseId, name])
  @@index([tenantId])
  @@map("assessment_category")
}

model GradeEntry {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  enrollmentId         String   @map("enrollment_id") @db.Uuid
  assessmentCategoryId String   @map("assessment_category_id") @db.Uuid
  termId               String   @map("term_id") @db.Uuid
  /// Optional link to the assignment the mark came from.
  assignmentId         String?  @map("assignment_id") @db.Uuid
  gradeScaleId         String   @map("grade_scale_id") @db.Uuid
  rawMark              Decimal  @map("raw_mark") @db.Decimal(6, 2)
  gradedAt             DateTime @default(now()) @map("graded_at") @db.Timestamptz(6)
  gradedByPersonId     String?  @map("graded_by_person_id") @db.Uuid
  comment              String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment         Enrollment         @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  assessmentCategory AssessmentCategory @relation(fields: [tenantId, assessmentCategoryId], references: [tenantId, id], onDelete: NoAction)
  term               Term               @relation(fields: [tenantId, termId], references: [tenantId, id], onDelete: NoAction)
  assignment         Assignment?        @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: NoAction)
  gradeScale         GradeScale         @relation(fields: [gradeScaleId], references: [id], onDelete: NoAction)
  gradedBy           Person?            @relation("GradeEntryGrader", fields: [tenantId, gradedByPersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, enrollmentId, termId])
  @@map("grade_entry")
}

/// DERIVED — computed from grade_entry by the gradebook service; the app role may only read it.
model TermGrade {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  termId       String   @map("term_id") @db.Uuid
  gradeScaleId String   @map("grade_scale_id") @db.Uuid
  value        Decimal  @db.Decimal(6, 2)
  percentage   Decimal? @db.Decimal(5, 2)
  /// Inputs snapshot (category averages, weights) used for the derivation.
  inputs       Json?
  computedAt   DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  term       Term       @relation(fields: [tenantId, termId], references: [tenantId, id], onDelete: Cascade)
  gradeScale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: NoAction)

  @@unique([tenantId, enrollmentId, termId])
  @@index([tenantId])
  @@map("term_grade")
}

/// DERIVED — computed from term_grade by the gradebook service; the app role may only read it.
model AnnualGrade {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  enrollmentId   String   @map("enrollment_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  gradeScaleId   String   @map("grade_scale_id") @db.Uuid
  value          Decimal  @db.Decimal(6, 2)
  percentage     Decimal? @db.Decimal(5, 2)
  inputs         Json?
  computedAt     DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Cascade)
  gradeScale   GradeScale   @relation(fields: [gradeScaleId], references: [id], onDelete: NoAction)

  @@unique([tenantId, enrollmentId, academicYearId])
  @@index([tenantId])
  @@map("annual_grade")
}

// ── Assignments ──

model Assignment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  classSectionId       String    @map("class_section_id") @db.Uuid
  assessmentCategoryId String?   @map("assessment_category_id") @db.Uuid
  createdByPersonId    String?   @map("created_by_person_id") @db.Uuid
  title                String
  instructions         String?
  /// Rubric: { criteria: [{ key, title, maxScore, levels?[] }] }. rubric_score.criterion_key refers to criteria[].key.
  rubric               Json?
  maxPoints            Decimal?  @map("max_points") @db.Decimal(6, 2)
  dueAt                DateTime? @map("due_at") @db.Timestamptz(6)
  /// e.g. { mode: "penalty", percentPerDay: 10, maxDays: 5 } | { mode: "accept" } | { mode: "reject" }.
  latePolicy           Json?     @map("late_policy")
  aiPolicy             AiPolicy  @default(guided) @map("ai_policy")
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSection       ClassSection        @relation(fields: [tenantId, classSectionId], references: [tenantId, id], onDelete: Cascade)
  assessmentCategory AssessmentCategory? @relation(fields: [tenantId, assessmentCategoryId], references: [tenantId, id], onDelete: NoAction)
  createdBy          Person?             @relation("AssignmentCreator", fields: [tenantId, createdByPersonId], references: [tenantId, id], onDelete: NoAction)
  submissions        Submission[]
  gradeEntries       GradeEntry[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, classSectionId])
  @@map("assignment")
}

model Submission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  assignmentId    String           @map("assignment_id") @db.Uuid
  studentPersonId String           @map("student_person_id") @db.Uuid
  /// 1 for the first hand-in; incremented on return-and-resubmit.
  attempt         Int              @default(1)
  status          SubmissionStatus @default(draft)
  textBody        String?          @map("text_body")
  /// Uploaded files: [{ storageKey, name, mimeType, bytes }].
  fileRefs        Json             @default("[]") @map("file_refs")
  /// Phone-camera photo uploads (mobile flow): [{ storageKey, mimeType, bytes, capturedAt }].
  photoRefs       Json             @default("[]") @map("photo_refs")
  submittedAt     DateTime?        @map("submitted_at") @db.Timestamptz(6)
  isLate          Boolean          @default(false) @map("is_late")
  plagiarismFlag  Boolean          @default(false) @map("plagiarism_flag")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment   Assignment    @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade)
  student      Person        @relation("SubmissionStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  rubricScores RubricScore[]

  @@unique([tenantId, id])
  @@unique([tenantId, assignmentId, studentPersonId, attempt])
  @@index([tenantId])
  @@map("submission")
}

model RubricScore {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  submissionId     String   @map("submission_id") @db.Uuid
  /// assignment.rubric.criteria[].key
  criterionKey     String   @map("criterion_key")
  score            Decimal  @db.Decimal(6, 2)
  comment          String?
  scoredByPersonId String?  @map("scored_by_person_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [tenantId, submissionId], references: [tenantId, id], onDelete: Cascade)
  scoredBy   Person?    @relation("RubricScoreScorer", fields: [tenantId, scoredByPersonId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, submissionId, criterionKey])
  @@index([tenantId])
  @@map("rubric_score")
}

// ── Notes, timeline, links, mastery ──

model Note {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  subjectPersonId String         @map("subject_person_id") @db.Uuid
  authorPersonId  String?        @map("author_person_id") @db.Uuid
  visibility      NoteVisibility @default(internal)
  body            String
  /// Optional anchor (e.g. "submission", id).
  entityType      String?        @map("entity_type")
  entityId        String?        @map("entity_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject Person  @relation("NoteSubject", fields: [tenantId, subjectPersonId], references: [tenantId, id], onDelete: Cascade)
  author  Person? @relation("NoteAuthor", fields: [tenantId, authorPersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, subjectPersonId])
  @@map("note")
}

/// APPEND-ONLY timeline: one row per mutation. The app role may SELECT and INSERT only.
/// (No updated_at: rows never change.)
model Event {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Actor: the person who caused the event (NULL = system).
  actorPersonId   String?  @map("actor_person_id") @db.Uuid
  /// Auth identity of the actor (from app.user_id), when known.
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  /// The student (or other person) the event is about — drives the profile timeline.
  subjectPersonId String?  @map("subject_person_id") @db.Uuid
  /// e.g. "grade_entry.created", "submission.returned", "attendance.recorded".
  type            String
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id") @db.Uuid
  payload         Json     @default("{}")
  /// Evidence references: [{ type: "submission"|"file"|"grade_entry"|..., id | storageKey }].
  evidenceRefs    Json     @default("[]") @map("evidence_refs")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor   Person? @relation("EventActor", fields: [tenantId, actorPersonId], references: [tenantId, id], onDelete: NoAction)
  subject Person? @relation("EventSubject", fields: [tenantId, subjectPersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, subjectPersonId, occurredAt])
  @@index([tenantId, entityType, entityId])
  /// Domain-event relay (@ssos/jobs) reads the log in (created_at, id) order.
  @@index([createdAt, id])
  @@map("event")
}

/// Typed links between any two tenant records (polymorphic; ids are not FK-checked).
model Edge {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id") @db.Uuid
  edgeType   String   @map("edge_type")
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId, edgeType, targetType, targetId])
  @@index([tenantId])
  @@index([tenantId, targetType, targetId])
  @@map("edge")
}

/// Created now, populated by a later slice.
model MasteryState {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  studentPersonId String    @map("student_person_id") @db.Uuid
  conceptId       String    @map("concept_id") @db.Uuid
  /// 0–1 mastery estimate.
  level           Decimal?  @db.Decimal(4, 3)
  evidenceCount   Int       @default(0) @map("evidence_count")
  lastEvidenceAt  DateTime? @map("last_evidence_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person  @relation("MasteryStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: NoAction)

  @@unique([tenantId, studentPersonId, conceptId])
  @@index([tenantId])
  @@index([conceptId])
  @@map("mastery_state")
}

// ─── Success engine (slice 1 — data model only) ──────────────────────────────
//
// Risk scores, tracks, action cards, alerts, interventions, goals and nudges.
// Every table is tenant-owned (tenant_id NOT NULL, one RLS template) and points at
// other tenant rows through composite FKs (tenant_id, x_id). Hand-written integrity
// rules (0–100 score, 0–1 confidence, one active config / track per student, one
// open alert per rule x student) live in the migration as CHECKs / partial indexes.
// Track transitions and interventions are only ever proposed as action cards.

enum RiskBand {
  low
  moderate
  high
  critical

  @@map("risk_band")
}

enum StudentTrack {
  excellence
  growth
  support

  @@map("student_track")
}

enum TrackAssignmentStatus {
  active
  superseded
  ended

  @@map("track_assignment_status")
}

enum ActionCardType {
  track_transition
  intervention
  goal
  alert_followup

  @@map("action_card_type")
}

enum ActionCardStatus {
  proposed
  approved
  edited
  dismissed
  expired

  @@map("action_card_status")
}

enum AlertSeverity {
  info
  warning
  critical

  @@map("alert_severity")
}

enum AlertState {
  open
  acknowledged
  escalated
  resolved
  dismissed

  @@map("alert_state")
}

enum InterventionSeverity {
  low
  medium
  high

  @@map("intervention_severity")
}

enum InterventionStatus {
  planned
  active
  completed
  cancelled

  @@map("intervention_status")
}

enum InterventionOutcome {
  improved
  no_change
  worsened
  inconclusive

  @@map("intervention_outcome")
}

enum InterventionTaskStatus {
  todo
  in_progress
  done
  skipped

  @@map("intervention_task_status")
}

enum GoalStatus {
  draft
  active
  achieved
  missed
  cancelled

  @@map("goal_status")
}

enum NudgeChannel {
  in_app
  email

  @@map("nudge_channel")
}

enum NudgeStatus {
  scheduled
  sent
  skipped
  cancelled

  @@map("nudge_status")
}

/// ENGINE-OWNED — per-tenant, versioned risk weights. A new version is a new row; exactly one
/// is active. The app role may only read it: changes go through writeRiskModelConfig (owner),
/// which always recomputes the tenant.
model RiskModelConfig {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  version           Int
  /// { gradeLevel, gradeTrend, attendanceLevel, attendanceTrend, lateMissing, engagement, concernNotes } -> weight.
  weights           Json
  /// Band cut-offs on the 0–100 score: { moderate, high, critical } (score >= value).
  bandThresholds    Json      @map("band_thresholds")
  isActive          Boolean   @default(false) @map("is_active")
  activatedAt       DateTime? @map("activated_at") @db.Timestamptz(6)
  createdByPersonId String?   @map("created_by_person_id") @db.Uuid
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  Person?     @relation("RiskModelConfigCreator", fields: [tenantId, createdByPersonId], references: [tenantId, id], onDelete: NoAction)
  riskScores RiskScore[]

  @@unique([tenantId, id])
  @@unique([tenantId, version])
  @@index([tenantId])
  @@map("risk_model_config")
}

/// DERIVED — computed by the risk model (src/risk-model.ts); the app role may only read it.
/// One computed risk score per (student, computation). History is kept; latest = max(computed_at).
model RiskScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  studentPersonId String   @map("student_person_id") @db.Uuid
  modelConfigId   String   @map("model_config_id") @db.Uuid
  modelVersion    Int      @map("model_version")
  /// 0–100.
  score           Decimal  @db.Decimal(5, 2)
  band            RiskBand
  /// [{ factor, value, weight, contribution, baseline }] — contributions sum to score; top-4 surfaced.
  factors         Json     @default("[]")
  /// Grade-cohort baseline the factors are measured against: { grade, cohortSize, factors: { key: value } }.
  cohortBaseline  Json     @default("{}") @map("cohort_baseline")
  computedAt      DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Person          @relation("RiskScoreStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  modelConfig RiskModelConfig @relation(fields: [tenantId, modelConfigId], references: [tenantId, id], onDelete: Restrict)
  actionCards ActionCard[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, studentPersonId, computedAt(sort: Desc)])
  @@index([tenantId, band])
  @@map("risk_score")
}

/// A student's track. Created only when an action card is approved/edited (never automatically) —
/// enforced by the `track_assignment_guard` trigger; rows can only be retired afterwards.
model TrackAssignment {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  studentPersonId String                @map("student_person_id") @db.Uuid
  track           StudentTrack
  status          TrackAssignmentStatus @default(active)
  /// [{ type: "risk_score"|"grade_entry"|"attendance_event"|"note"|..., id }].
  evidenceRefs    Json                  @default("[]") @map("evidence_refs")
  /// 0–1.
  confidence      Decimal               @db.Decimal(4, 3)
  effectiveDate   DateTime              @map("effective_date") @db.Date
  reviewDate      DateTime?             @map("review_date") @db.Date
  /// The approved card this assignment came from.
  actionCardId    String?               @map("action_card_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Person      @relation("TrackAssignmentStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  actionCard ActionCard? @relation(fields: [tenantId, actionCardId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, studentPersonId, effectiveDate(sort: Desc)])
  @@index([tenantId, track, status])
  @@map("track_assignment")
}

/// A proposed change awaiting a human decision (approve / edit / dismiss).
model ActionCard {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  type              ActionCardType
  subjectPersonId   String           @map("subject_person_id") @db.Uuid
  /// [{ type, id }] — what the proposal is based on.
  evidenceRefs      Json             @default("[]") @map("evidence_refs")
  /// 0–1.
  confidence        Decimal          @db.Decimal(4, 3)
  /// What would be applied on approval (e.g. { track: "support", reviewDate } or an intervention template).
  proposedPayload   Json             @map("proposed_payload")
  /// The payload actually applied when status = edited.
  decidedPayload    Json?            @map("decided_payload")
  /// System role key expected to decide (teacher | advisor | admin ...).
  assigneeRole      String           @map("assignee_role")
  status            ActionCardStatus @default(proposed)
  sourceRiskScoreId String?          @map("source_risk_score_id") @db.Uuid
  decidedByPersonId String?          @map("decided_by_person_id") @db.Uuid
  decidedAt         DateTime?        @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?          @map("decision_note")
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject          Person            @relation("ActionCardSubject", fields: [tenantId, subjectPersonId], references: [tenantId, id], onDelete: Cascade)
  decidedBy        Person?           @relation("ActionCardDecider", fields: [tenantId, decidedByPersonId], references: [tenantId, id], onDelete: NoAction)
  sourceRiskScore  RiskScore?        @relation(fields: [tenantId, sourceRiskScoreId], references: [tenantId, id], onDelete: NoAction)
  trackAssignments TrackAssignment[]
  interventions    Intervention[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status, assigneeRole])
  @@index([tenantId, subjectPersonId, createdAt(sort: Desc)])
  @@map("action_card")
}

/// Per-tenant alert thresholds and escalation ladder.
model AlertRule {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  key        String
  name       String
  /// Metric the rule watches, e.g. "risk_score", "attendance_rate", "late_submissions".
  metric     String
  /// { op: "gte"|"lte"|..., value, windowDays? }.
  threshold  Json
  severity   AlertSeverity @default(warning)
  /// Ordered ladder: [{ level, role: "teacher"|"advisor"|"parent", slaMinutes }].
  escalation Json
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("alert_rule")
}

model Alert {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  ruleId           String        @map("rule_id") @db.Uuid
  studentPersonId  String        @map("student_person_id") @db.Uuid
  state            AlertState    @default(open)
  severity         AlertSeverity
  /// Current rung of the rule's escalation ladder (0 = first).
  escalationLevel  Int           @default(0) @map("escalation_level")
  /// Role currently on the hook (from the ladder).
  assigneeRole     String        @map("assignee_role")
  /// SLA timer: escalate if not acknowledged by then.
  dueAt            DateTime?     @map("due_at") @db.Timestamptz(6)
  /// Value that triggered the alert and its evidence: { value, evidenceRefs }.
  trigger          Json          @default("{}")
  /// [{ personId, role, at, note? }].
  acknowledgements Json          @default("[]")
  triggeredAt      DateTime      @default(now()) @map("triggered_at") @db.Timestamptz(6)
  escalatedAt      DateTime?     @map("escalated_at") @db.Timestamptz(6)
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule          AlertRule      @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Cascade)
  student       Person         @relation("AlertStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  interventions Intervention[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, state, dueAt])
  @@index([tenantId, studentPersonId])
  @@map("alert")
}

model Intervention {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  studentPersonId String               @map("student_person_id") @db.Uuid
  /// Template the intervention was created from (templates live in code / a later slice).
  templateKey     String?              @map("template_key")
  /// e.g. "academic_tutoring", "attendance_plan", "mentoring", "family_meeting".
  type            String
  severity        InterventionSeverity @default(medium)
  ownerPersonId   String?              @map("owner_person_id") @db.Uuid
  status          InterventionStatus   @default(planned)
  actionCardId    String?              @map("action_card_id") @db.Uuid
  alertId         String?              @map("alert_id") @db.Uuid
  startedOn       DateTime?            @map("started_on") @db.Date
  endedOn         DateTime?            @map("ended_on") @db.Date
  outcome         InterventionOutcome?
  outcomeNote     String?              @map("outcome_note")
  /// Risk score at start / at close (0–100), captured for outcome measurement.
  riskBefore      Decimal?             @map("risk_before") @db.Decimal(5, 2)
  riskAfter       Decimal?             @map("risk_after") @db.Decimal(5, 2)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Person             @relation("InterventionStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  owner      Person?            @relation("InterventionOwner", fields: [tenantId, ownerPersonId], references: [tenantId, id], onDelete: NoAction)
  actionCard ActionCard?        @relation(fields: [tenantId, actionCardId], references: [tenantId, id], onDelete: NoAction)
  alert      Alert?             @relation(fields: [tenantId, alertId], references: [tenantId, id], onDelete: NoAction)
  tasks      InterventionTask[]
  goals      Goal[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, studentPersonId])
  @@index([tenantId, status])
  @@index([tenantId, ownerPersonId])
  @@map("intervention")
}

model InterventionTask {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  interventionId   String                 @map("intervention_id") @db.Uuid
  sequence         Int                    @default(0)
  title            String
  assigneePersonId String?                @map("assignee_person_id") @db.Uuid
  dueOn            DateTime?              @map("due_on") @db.Date
  status           InterventionTaskStatus @default(todo)
  completedAt      DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intervention Intervention @relation(fields: [tenantId, interventionId], references: [tenantId, id], onDelete: Cascade)
  assignee     Person?      @relation("InterventionTaskAssignee", fields: [tenantId, assigneePersonId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, interventionId, sequence])
  @@index([tenantId, assigneePersonId, status])
  @@map("intervention_task")
}

/// SMART goal: a measurable metric, a target and a deadline.
model Goal {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  studentPersonId   String     @map("student_person_id") @db.Uuid
  title             String
  /// e.g. "attendance_rate", "course_average", "late_submissions".
  metric            String
  /// Metric scope, e.g. { courseId } or { termId }.
  metricParams      Json       @default("{}") @map("metric_params")
  baseline          Decimal?   @db.Decimal(8, 2)
  target            Decimal    @db.Decimal(8, 2)
  deadline          DateTime   @db.Date
  status            GoalStatus @default(active)
  interventionId    String?    @map("intervention_id") @db.Uuid
  createdByPersonId String?    @map("created_by_person_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Person         @relation("GoalStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  createdBy    Person?        @relation("GoalCreator", fields: [tenantId, createdByPersonId], references: [tenantId, id], onDelete: NoAction)
  intervention Intervention?  @relation(fields: [tenantId, interventionId], references: [tenantId, id], onDelete: NoAction)
  progress     GoalProgress[]
  nudges       Nudge[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, studentPersonId, status])
  @@index([tenantId, status, deadline])
  @@map("goal")
}

/// Computed progress samples for a goal.
model GoalProgress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  measuredAt  DateTime @default(now()) @map("measured_at") @db.Timestamptz(6)
  value       Decimal  @db.Decimal(8, 2)
  /// 0–100 progress from baseline towards target.
  progressPct Decimal  @map("progress_pct") @db.Decimal(5, 2)
  /// What triggered the recompute (event type or "nightly").
  source      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goal   Goal   @relation(fields: [tenantId, goalId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, goalId, measuredAt(sort: Desc)])
  @@map("goal_progress")
}

/// At most one nudge per goal per week (unique on week_start).
model Nudge {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  goalId            String       @map("goal_id") @db.Uuid
  recipientPersonId String       @map("recipient_person_id") @db.Uuid
  /// Monday of the ISO week the nudge belongs to.
  weekStart         DateTime     @map("week_start") @db.Date
  channel           NudgeChannel @default(in_app)
  status            NudgeStatus  @default(scheduled)
  /// Message key + params, rendered in the recipient's locale.
  payload           Json         @default("{}")
  scheduledFor      DateTime     @map("scheduled_for") @db.Timestamptz(6)
  sentAt            DateTime?    @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goal      Goal   @relation(fields: [tenantId, goalId], references: [tenantId, id], onDelete: Cascade)
  recipient Person @relation("NudgeRecipient", fields: [tenantId, recipientPersonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, goalId, weekStart])
  @@index([tenantId])
  @@index([tenantId, status, scheduledFor])
  @@map("nudge")
}

// ─── Communications (slice 1: data model) ───────────────────────────────────

/// External delivery channels. In-app delivery is a `notification` row, not a channel.
enum CommChannel {
  whatsapp
  telegram
  email
  sms
  push

  @@map("comm_channel")
}

/// Opt-in state of one external address. STOP (any channel) -> opted_out.
enum ChannelOptInState {
  pending
  opted_in
  opted_out

  @@map("channel_opt_in_state")
}

/// Outbox lifecycle (enforced by the `outbox_state_guard` trigger):
/// queued -> sending | cancelled; sending -> sent | failed | dead; sent -> delivered | failed;
/// failed -> sending (retry) | dead | cancelled. delivered, dead and cancelled are final.
enum OutboxState {
  queued
  sending
  sent
  delivered
  failed
  dead
  cancelled

  @@map("outbox_state")
}

enum ThreadScope {
  student
  class_section

  @@map("thread_scope")
}

enum MessageDirection {
  outbound
  inbound

  @@map("message_direction")
}

enum AnnouncementAudience {
  school
  role
  class_section

  @@map("announcement_audience")
}

enum NotificationCategory {
  alert
  digest
  message
  announcement
  nudge
  system

  @@map("notification_category")
}

enum DigestRunState {
  pending
  running
  completed
  failed

  @@map("digest_run_state")
}

/// A conversation about one student (teacher <-> family) or one class section.
model Thread {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  scope             ThreadScope
  /// Set iff scope = student.
  studentPersonId   String?     @map("student_person_id") @db.Uuid
  /// Set iff scope = class_section.
  classSectionId    String?     @map("class_section_id") @db.Uuid
  subject           String?
  createdByPersonId String?     @map("created_by_person_id") @db.Uuid
  lastMessageAt     DateTime?   @map("last_message_at") @db.Timestamptz(6)
  archivedAt        DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Person?        @relation("ThreadStudent", fields: [tenantId, studentPersonId], references: [tenantId, id], onDelete: Cascade)
  classSection  ClassSection?  @relation(fields: [tenantId, classSectionId], references: [tenantId, id], onDelete: Cascade)
  createdBy     Person?        @relation("ThreadCreator", fields: [tenantId, createdByPersonId], references: [tenantId, id], onDelete: NoAction)
  messages      Message[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, studentPersonId])
  @@index([tenantId, classSectionId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("thread")
}

model Message {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  threadId          String           @map("thread_id") @db.Uuid
  direction         MessageDirection @default(outbound)
  /// Null for an inbound reply whose sender could not be matched to a person.
  authorPersonId    String?          @map("author_person_id") @db.Uuid
  body              String
  /// Channel an inbound message arrived on (null = written in the app).
  channel           CommChannel?
  channelBindingId  String?          @map("channel_binding_id") @db.Uuid
  /// Provider message id of an inbound message (webhook idempotency).
  externalMessageId String?          @map("external_message_id")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thread         Thread          @relation(fields: [tenantId, threadId], references: [tenantId, id], onDelete: Cascade)
  author         Person?         @relation("MessageAuthor", fields: [tenantId, authorPersonId], references: [tenantId, id], onDelete: NoAction)
  channelBinding ChannelBinding? @relation(fields: [tenantId, channelBindingId], references: [tenantId, id], onDelete: NoAction)
  outbox         Outbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, channel, externalMessageId])
  @@index([tenantId])
  @@index([tenantId, threadId, createdAt])
  @@map("message")
}

/// One external address of a person on one channel, with its opt-in state.
model ChannelBinding {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  personId   String            @map("person_id") @db.Uuid
  channel    CommChannel
  /// Phone (E.164), Telegram chat id, e-mail address or push endpoint.
  externalId String            @map("external_id")
  optInState ChannelOptInState @default(pending) @map("opt_in_state")
  /// Preferred language for templates on this channel (falls back to person/tenant locale).
  locale     String?           @db.VarChar(8)
  /// Provider-specific extras (e.g. Web Push keys). Never secrets of ours.
  meta       Json              @default("{}")
  verifiedAt DateTime?         @map("verified_at") @db.Timestamptz(6)
  optedInAt  DateTime?         @map("opted_in_at") @db.Timestamptz(6)
  optedOutAt DateTime?         @map("opted_out_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person   Person    @relation("ChannelBindingPerson", fields: [tenantId, personId], references: [tenantId, id], onDelete: Cascade)
  messages Message[]
  outbox   Outbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, channel, externalId])
  @@index([tenantId])
  @@index([tenantId, personId, channel])
  @@map("channel_binding")
}

/// Transactional outbox: one row per (recipient, channel) delivery attempt chain.
model Outbox {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  channel           CommChannel
  recipientPersonId String?     @map("recipient_person_id") @db.Uuid
  channelBindingId  String?     @map("channel_binding_id") @db.Uuid
  /// Template key, e.g. "digest.weekly", "alert.critical".
  template          String
  locale            String      @db.VarChar(8)
  /// Template variables.
  payload           Json        @default("{}")
  state             OutboxState @default(queued)
  attempts          Int         @default(0)
  maxAttempts       Int         @default(5) @map("max_attempts")
  /// Earliest time the next attempt may run (retry backoff, quiet hours).
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?     @map("last_error")
  providerMessageId String?     @map("provider_message_id")
  /// Caller-chosen key so enqueueing twice is a no-op.
  idempotencyKey    String?     @map("idempotency_key")
  notificationId    String?     @map("notification_id") @db.Uuid
  messageId         String?     @map("message_id") @db.Uuid
  digestRunId       String?     @map("digest_run_id") @db.Uuid
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?   @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient      Person?         @relation("OutboxRecipient", fields: [tenantId, recipientPersonId], references: [tenantId, id], onDelete: Cascade)
  channelBinding ChannelBinding? @relation(fields: [tenantId, channelBindingId], references: [tenantId, id], onDelete: NoAction)
  notification   Notification?   @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: NoAction)
  message        Message?        @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: NoAction)
  digestRun      DigestRun?      @relation(fields: [tenantId, digestRunId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([state, nextAttemptAt])
  @@index([tenantId, recipientPersonId, createdAt(sort: Desc)])
  @@index([tenantId, providerMessageId])
  @@map("outbox")
}

/// School-, role- or class-wide announcement. Read receipts are the per-recipient
/// `notification` rows (category = announcement) and their `read_at`.
model Announcement {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  authorPersonId String?              @map("author_person_id") @db.Uuid
  audience       AnnouncementAudience @default(school)
  /// System role key; set iff audience = role.
  audienceRole   String?              @map("audience_role")
  /// Set iff audience = class_section.
  classSectionId String?              @map("class_section_id") @db.Uuid
  title          String
  body           String
  locale         String               @db.VarChar(8)
  publishedAt    DateTime?            @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author        Person?        @relation("AnnouncementAuthor", fields: [tenantId, authorPersonId], references: [tenantId, id], onDelete: NoAction)
  classSection  ClassSection?  @relation(fields: [tenantId, classSectionId], references: [tenantId, id], onDelete: Cascade)
  notifications Notification[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, publishedAt(sort: Desc)])
  @@map("announcement")
}

/// In-app notification for one person (also the read receipt of an announcement).
model Notification {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  recipientPersonId String               @map("recipient_person_id") @db.Uuid
  category          NotificationCategory
  /// Message key + params, rendered in the recipient's locale.
  payload           Json                 @default("{}")
  /// The student the notification is about (parents with several children).
  subjectPersonId   String?              @map("subject_person_id") @db.Uuid
  alertId           String?              @map("alert_id") @db.Uuid
  announcementId    String?              @map("announcement_id") @db.Uuid
  threadId          String?              @map("thread_id") @db.Uuid
  readAt            DateTime?            @map("read_at") @db.Timestamptz(6)
  acknowledgedAt    DateTime?            @map("acknowledged_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient    Person        @relation("NotificationRecipient", fields: [tenantId, recipientPersonId], references: [tenantId, id], onDelete: Cascade)
  subject      Person?       @relation("NotificationSubject", fields: [tenantId, subjectPersonId], references: [tenantId, id], onDelete: Cascade)
  alert        Alert?        @relation(fields: [tenantId, alertId], references: [tenantId, id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Cascade)
  thread       Thread?       @relation(fields: [tenantId, threadId], references: [tenantId, id], onDelete: Cascade)
  outbox       Outbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, announcementId, recipientPersonId])
  @@index([tenantId])
  @@index([tenantId, recipientPersonId, createdAt(sort: Desc)])
  @@index([tenantId, alertId])
  @@map("notification")
}

/// Delivery preference for one category. Either a role default (role_key set) or a
/// person's override (person_id set) — never both. Quiet hours are minutes of the day in
/// the tenant's time zone; start > end wraps midnight; start = end means none.
model NotificationPreference {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  roleKey               String?              @map("role_key")
  personId              String?              @map("person_id") @db.Uuid
  category              NotificationCategory
  /// Ordered by preference; the first opted-in binding wins, later ones are fallbacks.
  channels              CommChannel[]
  enabled               Boolean              @default(true)
  quietStartMinute      Int?                 @map("quiet_start_minute")
  quietEndMinute        Int?                 @map("quiet_end_minute")
  /// Critical alerts are delivered immediately even inside quiet hours.
  criticalBypassesQuiet Boolean              @default(true) @map("critical_bypasses_quiet")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person? @relation("NotificationPreferencePerson", fields: [tenantId, personId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, personId])
  @@map("notification_preference")
}

/// One weekly (or other) digest batch for a tenant and period.
model DigestRun {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  /// e.g. "weekly".
  kind        String         @default("weekly")
  periodStart DateTime       @map("period_start") @db.Date
  periodEnd   DateTime       @map("period_end") @db.Date
  state       DigestRunState @default(pending)
  /// { recipients, students, enqueued, skipped }.
  stats       Json           @default("{}")
  error       String?
  startedAt   DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?      @map("finished_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outbox Outbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, kind, periodStart])
  @@index([tenantId])
  @@map("digest_run")
}
